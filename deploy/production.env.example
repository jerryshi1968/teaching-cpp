# 对应当前 Apache + PM2 服务器；后续部署步骤会说明如何放置和设置权限。
# 目标：/var/www/teaching-cpp-backend/.env。不要放进公网前端目录。
NODE_ENV=production
APP_MODE=production
PORT=5180

# 必须先完成备份、迁移和旧 p5.js 类别过滤，才可开放写入。
CPP_PRODUCTION_WRITES=disabled
CPP_RUN_ENABLED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teaching_p5js
# 后续创建最小权限账号；不是要求你现在改动原站的 dbadmin 配置。
DB_USER=cpp_app
DB_PASSWORD=REPLACE_ON_SERVER
COMMON_API_URL=http://127.0.0.1:5080/api

CPP_STORAGE_ROOT=/var/www/teaching-cpp-backend/storage
CPP_CACHE_TOTAL_MB=2048
CPP_MIN_FREE_MB=1024
RUNNER_URL=http://127.0.0.1:5280
# 暂不启用真实运行；启用之前填写随机内部令牌及固定镜像 ID。
RUNNER_TOKEN=
# CPP_COMPILER_IMAGE=sha256:<64位真实镜像ID>
