{
  "name": "teaching-cpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend", "runner"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "runner": "npm run start --workspace runner",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:linux": "node scripts/linux-smoke.mjs",
    "db:migrate": "node backend/src/migrate.mjs",
    "db:fixture": "node scripts/create-test-schema.mjs"
  },
  "devDependencies": { "supertest": "^7.1.1" }
}
