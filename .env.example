# 本机演示不读取旧平台数据库，不会执行学生 C++。
APP_MODE=demo
PORT=5100
CPP_RUN_ENABLED=false
CPP_PRODUCTION_WRITES=disabled

# test 必须使用以 _test 结尾的独立数据库。production 需独立审查后启用。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teaching_cpp_test
DB_USER=cpp_app
DB_PASSWORD=replace-locally
COMMON_API_URL=http://127.0.0.1:5000/api

# 生产使用独立目录，例如 /var/lib/teaching-cpp；不要指向 p5.js 的存储目录。
# CPP_STORAGE_ROOT=/var/lib/teaching-cpp
CPP_CACHE_TOTAL_MB=2048
CPP_MIN_FREE_MB=1024
RUNNER_URL=http://127.0.0.1:5200
RUNNER_TOKEN=replace-with-a-random-token-at-least-32-characters
# 使用 Podman image inspect 返回的完整 sha256 ID，后端和执行服务必须相同。
# CPP_COMPILER_IMAGE=sha256:<64位十六进制镜像ID>
